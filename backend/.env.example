# ---- Standalone run / integration settings for the BVMS backend ----
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Database: leave DATABASE_URL empty to use SQLite (demo). Production: PostgreSQL.
DATABASE_URL=
# e.g. postgres://mcg:mcg@localhost:5432/mcg_sms
# Media storage root (or point MEDIA_ROOT at the existing sms-be /media volume)
MEDIA_ROOT=./media
# Existing MCG platform user directory (set to 1 when mounted inside the sms-be project)
BVMS_USE_PLATFORM_AUTH=0
# DULB Property-ID API (same API the MCG platform already calls)
PID_API_BASE=https://property.ulbharyana.gov.in/api
PID_API_USER=
PID_API_PASSWORD=
PID_MC_CODE=012
# Optional: proxy PID lookups through the existing MCG backend endpoint instead
PID_PLATFORM_PROXY_URL=
# SMS gateway (any HTTP gateway; see integrations/sms.py)
SMS_GATEWAY=console            # console | http
SMS_HTTP_URL=
SMS_HTTP_METHOD=POST
SMS_HTTP_AUTH_HEADER=
SMS_SENDER_ID=MCGGGN
SMS_DLT_TEMPLATE_SCN=
SMS_DLT_TEMPLATE_ORDER=
# Digital signature: local (PKCS#12 file) | pkcs11 (USB DSC token on the signing server) | esign (Aadhaar eSign ASP)
SIGNER=local
SIGNER_P12_PATH=./building_violations/keys/dev-signer.p12
SIGNER_P12_PASSWORD=mcgdev
SIGNER_PKCS11_LIB=
SIGNER_PKCS11_SLOT=
SIGNER_ESIGN_URL=
SIGNER_ESIGN_ASP_ID=
# Public verification base (QR on every notice points here)
PUBLIC_VERIFY_BASE=http://localhost:5173/building-violations/verify
# Celery / Redis (timers, SLA escalations, SMS retries). Empty = run synchronously.
CELERY_BROKER_URL=
# Corporation identity printed on notices
MCG_NAME_EN=Municipal Corporation Gurugram
MCG_NAME_HI=नगर निगम गुरुग्राम
MCG_ADDRESS=Civil Lines, Gurugram - 122001, Haryana
MCG_HELPLINE=0124-2322877
