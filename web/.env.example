# Web portal settings (Vite). Copy to .env / .env.local.
# API base of the module (dev: leave unset and the Vite proxy forwards /building-violations/api to :8000)
VITE_API_BASE=
# Router base when mounted inside the platform portal (default /building-violations)
VITE_ROUTER_BASENAME=
# Google Maps JavaScript API key (the platform's primary map library). Without it the map uses Leaflet + OpenStreetMap.
VITE_GOOGLE_MAPS_API_KEY=
# Dev-server proxy target for the API (default http://127.0.0.1:8000)
VITE_API_PROXY=
