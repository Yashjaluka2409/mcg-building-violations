{
  "name": "mcg-building-violations-web",
  "private": true,
  "version": "2.0.0",
  "description": "MCG Building Violation Management System - web portal module. Same stack as web-sanitary-monitoring-system-fe: React 18 + Vite 5 + TypeScript, Tailwind 3.4, Radix UI, lucide-react, Redux Toolkit + redux-persist (auth/session), Zustand (local state), Axios interceptors, TanStack React Query v5, React Hook Form + Zod, Google Maps JS API (Leaflet fallback).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint src --ext .ts,.tsx"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.1.1",
    "@radix-ui/react-dialog": "^1.1.14",
    "@radix-ui/react-dropdown-menu": "^2.1.15",
    "@radix-ui/react-tooltip": "^1.2.7",
    "@react-google-maps/api": "^2.20.6",
    "@reduxjs/toolkit": "^2.8.2",
    "@tanstack/react-query": "^5.102.0",
    "axios": "^1.11.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "i18next": "^24.2.0",
    "leaflet": "^1.9.4",
    "lucide-react": "^0.469.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.62.0",
    "react-i18next": "^15.4.0",
    "react-leaflet": "^4.2.1",
    "react-redux": "^9.2.0",
    "react-router-dom": "^6.28.1",
    "recharts": "^2.15.0",
    "redux-persist": "^6.0.0",
    "zod": "^4.0.0",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@types/leaflet": "^1.9.15",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.2",
    "vite": "^5.4.19"
  }
}
